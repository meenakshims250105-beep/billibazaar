{
  "name": "billi-bazaar-market",
  "version": "1.0.0",
  "private": true,
  "description": "Billi Bazaar secondhand fashion marketplace",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.rewear.market",
    "productName": "Billi Bazaar",
    "directories": { "output": "dist-app" },
    "files": [
      "index.html",
      "checkout.html",
      "styles.css",
      "design-system.css",
      "brand.css",
      "checkout.css",
      "app.js",
      "checkout.js",
      "manifest.webmanifest",
      "icon.svg",
      "electron-main.cjs",
      "package.json"
    ],
    "win": { "target": ["portable"], "artifactName": "Billi-Bazaar-${version}-Windows.exe" }
  }
}
